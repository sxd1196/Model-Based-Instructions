node_modules
dist
dist-ssr
*.local

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / build output
coverage
.vite
*.tsbuildinfo

# CAD working files — converted geometry does not belong in git.
# Keep source STEP in PLM, keep converted glTF next to the project locally.
*.step
*.stp
*.STEP
*.STP
*.sldasm
*.SLDASM
*.sldprt
*.SLDPRT
*.glb
*.gltf
!src/**/*.glb

# EXCEPTION: the tiny generated STEP test fixtures MUST be tracked, or
# importCad.test.ts fails in every fresh clone (8 tests). They are ~15KB each
# and deterministic — regenerate with `npm run fixtures`.
!src/cad/fixtures/*.step
!src/cad/fixtures/*.stp

# Exported artifacts
*.webm
*.assemblyproj.json
*-instructions.html

# Smoke test artifacts
.smoke/

# WASM is copied from node_modules by scripts/sync-wasm.mjs
public/wasm/
